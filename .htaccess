# Sugam Home Care Services - Apache Web Server Optimization (.htaccess)

# 1. Force HTTPS & Canonical Redirects
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect old service URLs to new service URLs
Redirect 301 /maid-services/ /caretaker-services-at-home/
Redirect 301 /baby-care-taker/ /baby-care-services/
Redirect 301 /caretaker-services/ /caretaker-services-at-home/
Redirect 301 /home-health-care-services/ /home-health-care-for-seniors/
Redirect 301 /nursing-services-at-home/ /nursing-services/

# Ensure trailing slash on directories for clean SEO URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# 2. Enable GZIP / Brotli Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 3. Dynamic Cache Invalidation & Static Asset Caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpg "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 0 seconds"
ExpiresByType application/javascript "access plus 0 seconds"
ExpiresByType text/javascript "access plus 0 seconds"
ExpiresDefault "access plus 0 seconds"
</IfModule>

# HTML, PHP, directories, JS, and CSS pages must never be cached by CDN or Browser
<IfModule mod_headers.c>
  Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"

  <FilesMatch "\.(jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Disable Directory Browsing & Protect Sensitive Files
Options -Indexes

<FilesMatch "^\.|\.(jsonl|log|ini|sh|py)$">
    Order allow,deny
    Deny from all
</FilesMatch>
